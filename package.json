{
  "name": "playwright-cucumber",
  "version": "1.0.0",
  "scripts": {
    "test": "cucumber-js src/test/features/",
    "posttest": "ts-node src/helper/report.ts",
    "report": "ts-node src/helper/report.ts",
    "smoke": "cucumber-js --tags @smoke",
