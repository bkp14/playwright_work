    "parallel": "cucumber-js --parallel 2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "multiple-cucumber-html-reporter": "^3.9.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.5"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
